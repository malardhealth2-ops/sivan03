generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique @default("")
  phone     String?  @unique
  email     String?  @unique
  password  String?
  fullName  String   @default("")
  role      String   @default("passenger") // passenger, driver, admin
  avatarUrl String?
  isActive  Boolean  @default(true)
  isVerified Boolean @default(false)
  lastLoginAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  passenger Passenger?
  driver    Driver?
  blogPosts BlogPost[]
  notifications Notification[]
  transactions Transaction[]
  supportTickets SupportTicket[]
  activityLogs  ActivityLog[]
}

model Passenger {
  id          String   @id @default(cuid())
  userId      String   @unique
  nationalId  String?
  gender      String?
  birthDate   String?
  walletBalance Float   @default(0)
  rating      Float    @default(5.0)
  totalTrips  Int      @default(0)
  referralCode String  @unique
  referredBy  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  trips  Trip[]
  reviews Review[]
}

model Driver {
  id              String   @id @default(cuid())
  userId          String   @unique
  nationalId      String   @unique
  fatherName      String?
  licenseNumber   String?
  licenseExpiry   String?
  healthCertExpiry String?
  verificationStatus String @default("pending") // pending, approved, rejected, suspended
  rating          Float    @default(5.0)
  totalTrips      Int      @default(0)
  acceptanceRate  Float    @default(100.0)
  completionRate  Float   @default(100.0)
  currentLat      Float?
  currentLng      Float?
  onlineStatus    String   @default("offline") // online, offline, busy
  balance         Float    @default(0)
  shebaNumber     String?
  bankName        String?
  accountOwner    String?
  joinedAt        DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle  Vehicle?
  trips    Trip[]
  reviews  Review[]
  earnings Earning[]
}

model Vehicle {
  id                String   @id @default(cuid())
  driverId          String   @unique
  type              String   @default("sedan") // sedan, suv, van, electric
  brand             String
  model             String
  year              Int
  color             String
  plateNumber       String   @unique
  insuranceExpiry   String?
  techDiagExpiry    String?
  status            String   @default("active") // active, inactive, maintenance
  images            String   @default("[]") // JSON array
  createdAt         DateTime @default(now())

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)
}

model Trip {
  id              String    @id @default(cuid())
  bookingCode     String    @default("")
  passengerId     String?
  driverId        String?
  passengerName   String?
  passengerPhone  String?
  originAddress   String
  originLat       Float?
  originLng       Float?
  destAddress     String
  destLat         Float?
  destLng         Float?
  tripType        String    @default("economy") // economy, vip, luxury, van, electric
  status          String    @default("pending") // pending, accepted, driver_arrived, in_progress, completed, cancelled, no_show
  requestedAt     DateTime  @default(now())
  acceptedAt      DateTime?
  pickedUpAt      DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  scheduledFor    DateTime?
  baseFare        Float     @default(0)
  distanceFare    Float     @default(0)
  timeFare        Float     @default(0)
  discountAmount  Float     @default(0)
  totalFare       Float     @default(0)
  commissionAmt   Float     @default(0)
  driverEarnings  Float     @default(0)
  paymentMethod   String    @default("cash") // cash, online, wallet
  paymentStatus   String    @default("pending") // pending, paid, refunded
  distanceKm      Float?
  durationMin     Int?
  passengerCount  Int       @default(1)
  notes           String?
  cancelReason    String?
  cancelledBy     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  passenger Passenger? @relation(fields: [passengerId], references: [id])
  driver    Driver?   @relation(fields: [driverId], references: [id])
  reviews   Review[]
  transactions Transaction[]
}

model Review {
  id          String   @id @default(cuid())
  tripId      String
  reviewerId  String
  targetId    String // driver or passenger id
  targetType  String  @default("driver") // driver, passenger
  rating      Int     @default(5)
  comment     String?
  createdAt   DateTime @default(now())

  trip      Trip      @relation(fields: [tripId], references: [id])
  passenger Passenger? @relation(fields: [reviewerId], references: [id])
  driver    Driver?   @relation(fields: [reviewerId], references: [id])
}

model Transaction {
  id          String    @id @default(cuid())
  userId      String
  tripId      String?
  type        String    @default("credit") // credit, debit, commission, refund, topup, withdrawal
  amount      Float
  description String?
  referenceId String?
  status      String    @default("pending") // pending, completed, failed
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])
  trip Trip? @relation(fields: [tripId], references: [id])
}

model Earning {
  id          String   @id @default(cuid())
  driverId    String
  amount      Float
  period      String  @default("today") // today, week, month
  tripCount   Int     @default(0)
  commission  Float   @default(0)
  createdAt   DateTime @default(now())

  driver Driver @relation(fields: [driverId], references: [id])
}

model BlogPost {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  excerpt         String?
  content         String
  featuredImageUrl String?
  authorId        String?
  categoryId      String?
  category        BlogCategory? @relation(fields: [categoryId], references: [id])
  tags            String   @default("[]") // JSON array
  status          String   @default("draft") // draft, published, archived
  publishedAt     DateTime?
  viewCount       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  author User? @relation(fields: [authorId], references: [id])
  comments BlogComment[]
}

model BlogCategory {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  posts BlogPost[]
}

model BlogComment {
  id       String   @id @default(cuid())
  postId   String
  authorId String?
  parentId String?
  content  String
  isApproved Boolean @default(false)
  createdAt DateTime @default(now())

  post BlogPost @relation(fields: [postId], references: [id])
}

model Coupon {
  id              String   @id @default(cuid())
  code            String   @unique
  description     String?
  discountType    String   @default("percentage") // percentage, fixed
  discountValue   Float
  minOrderAmount  Float    @default(0)
  maxDiscount     Float?
  usageLimit      Int?
  usageCount      Int      @default(0)
  validFrom       DateTime
  validUntil      DateTime
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
}

model SupportTicket {
  id          String   @id @default(cuid())
  userId      String
  subject     String
  description String
  priority    String   @default("medium") // low, medium, high, urgent
  status      String   @default("open") // open, in_progress, waiting, resolved, closed
  assignedTo  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user       User              @relation(fields: [userId], references: [id])
  messages   TicketMessage[]
}

model TicketMessage {
  id          String   @id @default(cuid())
  ticketId    String
  senderId    String
  message     String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("info") // info, success, warning, error
  channel   String   @default("in_app") // sms, email, push, in_app
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entityType String?
  entityId   String?
  ipAddress String?
  userAgent  String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}

model SiteSettings {
  id          String @id @default("main")
  siteName    String @default("تاکسی ویژه سیوان")
  siteUrl     String @default("https://sivantaxi.com")
  phone1      String @default("09109419743")
  phone2      String @default("09368816807")
  email       String @default("info@sivantaxi.com")
  address     String @default("")
  aboutText   String @default("")
  commissionRate Float @default(10.0)
  minWithdrawal Float @default(500000)
  workingHours String @default("۲۴ ساعته - ۷ روز هفته")
  notifyEmail String @default("")
  // Internal mail system sender identity (the site's own domain)
  mailSenderName    String @default("تاکسی ویژه سیوان")
  mailSenderEmail   String @default("noreply@sivantaxi.com")
  mailReplyTo       String @default("info@sivantaxi.com")
  // Optional outbound SMTP relay (used when direct MX delivery is blocked, e.g. cloud sandboxes)
  // When all three are empty, the mail service delivers directly to recipient MX servers on port 25.
  relayHost         String @default("")
  relayPort         String @default("587")
  relayUser         String @default("")
  relayPass         String @default("")
  updatedAt   DateTime @updatedAt
}

model EmailMessage {
  id          String   @id @default(cuid())
  // Sender identity used for this message (snapshot from SiteSettings at send time)
  fromName    String   @default("تاکسی ویژه سیوان")
  fromEmail   String   @default("noreply@sivantaxi.com")
  replyTo     String?
  // Recipient
  toEmail     String
  toName      String?
  subject     String
  textBody    String   @default("")
  htmlBody    String   @default("")
  // Status: queued | sending | sent | failed
  status      String   @default("queued")
  // SMTP/MX delivery details (for debugging + admin transparency)
  mxHost      String? // which MX server was contacted
  attemptCount Int    @default(0)
  lastError   String?
  // Context: why this email was sent
  source      String   @default("manual") // manual | booking | system
  refId       String? // e.g. trip id for booking notifications
  sentAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([toEmail])
  @@index([createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  // The PushSubscription.endpoint URL (unique per browser/device)
  endpoint  String   @unique
  // p256dh + auth keys (base64url) needed by web-push to encrypt payloads
  p256dhKey String   @default("")
  authKey   String   @default("")
  // Optional label so admin can identify the device (e.g. "iPhone", "Office PC")
  label     String   @default("")
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

model PopularRoute {
  id          String @id @default(cuid())
  origin      String
  destination String
  price       Int      @default(0) // stored base price (fallback if not computed)
  distanceKm  Float    @default(0) // used to compute live price from admin PricingConfig rates
  duration    String   @default("")
  tripType    String   @default("vip") // which per-km rate to use when computing the live price
  image       String?
  isPopular   Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
}

model Testimonial {
  id        String @id @default(cuid())
  name      String
  avatarUrl String?
  rating    Int    @default(5)
  comment   String
  tripRoute String?
  isApproved Boolean @default(true)
  userId    String?  // linked user when submitted by a logged-in passenger
  createdAt DateTime @default(now())
}

model SiteContent {
  id        String   @id @default(cuid())
  section   String   @unique // hero, services, whyUs, fleet, cta, footer, etc.
  title     String   @default("")
  subtitle  String   @default("")
  body      String   @default("") // can be JSON string for complex content
  updatedAt DateTime @updatedAt
}

model PricingConfig {
  id             String   @id @default("main")
  baseFare       Float    @default(50000) // هزینه پایه (ورود به سفر)
  minFare        Float    @default(100000) // حداقل کرایه
  economyPerKm   Float    @default(2000) // اقتصادی - تومان بر کیلومتر
  vipPerKm       Float    @default(3000) // VIP لوکس
  luxuryPerKm    Float    @default(5000) // دربستی ویژه
  vanPerKm       Float    @default(2500) // ون
  electricPerKm  Float    @default(3500) // برقی
  roundTripDiscount Float @default(0) // درصد تخفیف رفت و برگشت
  updatedAt      DateTime @updatedAt
}

model BlogGeneratorState {
  id                String   @id @default("main")
  cycleIndex        Int      @default(0)
  categoryTopicIndex String   @default("{}") // JSON: { tourism: 3, "luxury-cars": 1, ... }
  lastAutoGenAt     DateTime? // timestamp of the last scheduled auto-generation
  totalAutoGenerated Int     @default(0)
  updatedAt         DateTime @updatedAt
}
